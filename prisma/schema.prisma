generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============ USER ============
model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  email          String    @unique
  password       String
  name           String
  role           String
  profilePicture String?
  contact        String?
  lastSeenAt     DateTime? // online heartbeat
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Student fields
  registrationNumber String?
  program            String?
  semester           Int?
  cgpa               Float?
  university         String?
  batch              String?
  seatNumber         String?
  city               String?
  country            String?
  enrolledCourses    String[]
  skills             String[]
  interestAreas      String[]
  experienceLevel    String?
  githubLink         String?
  linkedinProfile    String?
  portfolioLink      String?

  // Teacher fields
  employeeId         String?
  department         String?
  designation        String?
  researchAreas      String[]
  publications       String[]
  supervisionDomains String[]
  maxProjects        Int      @default(5)

  // Relations
  ledTeams           Team[]          @relation("TeamLead")
  teamMemberships    TeamMember[]
  supervisedProjects Project[]       @relation("Supervisor")
  joinRequestsSent   JoinRequest[]   @relation("Requester")
  submissions        Submission[]    @relation("SubmittedBy")
  feedbackGiven      Feedback[]      @relation("FeedbackAuthor")
  repliesGiven       FeedbackReply[] @relation("ReplyAuthor")
  messages           Message[]       @relation("MessageAuthor")
  tasksAssigned      Task[]          @relation("TaskAssignee")
  invitesReceived    Invite[]        @relation("InviteeUser")
  invitesSent        Invite[]        @relation("InviteSender")


  @@index([role])
  @@index([registrationNumber])
  @@index([employeeId])
}

// ============ TEAM ============
model Team {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  maxSize          Int      @default(5)
  description      String?
  isOpen           Boolean  @default(true)
  supervisorStatus String   @default("NONE") // NONE | PENDING | ACCEPTED | DECLINED
  projectDomain    String?
  skills           String[]

  leadId String @db.ObjectId
  lead   User   @relation("TeamLead", fields: [leadId], references: [id])

  members      TeamMember[]
  project      Project?
  joinRequests JoinRequest[]
  invites      Invite[]
  tasks        Task[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectDomain])
  @@index([isOpen])
}

// ============ TEAM MEMBER ============
model TeamMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @db.ObjectId
  teamId   String   @db.ObjectId
  role     String   @default("MEMBER") // LEAD | MEMBER
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId])
  @@index([teamId])
}

// ============ JOIN REQUEST ============
model JoinRequest {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  message String?
  status  String  @default("pending") // pending | accepted | declined

  requesterId String @db.ObjectId
  teamId      String @db.ObjectId

  requester User @relation("Requester", fields: [requesterId], references: [id])
  team      Team @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requesterId, teamId])
  @@index([status])
  @@index([teamId])
  @@index([requesterId])
}

// ============ PROJECT ============
model Project {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  timelineStart DateTime?
  timelineEnd   DateTime?
  status        String    @default("DRAFT")

  teamId       String  @unique @db.ObjectId
  supervisorId String? @db.ObjectId

  team       Team  @relation(fields: [teamId], references: [id])
  supervisor User? @relation("Supervisor", fields: [supervisorId], references: [id])

  milestones Milestone[]
  tasks      Task[]
  feedback   Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId])
}

// ============ MILESTONE ============
model Milestone {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  deadline    DateTime
  status      String   @default("pending") // pending | approved | revision

  projectId   String   @db.ObjectId
  assigneeIds String[] @db.ObjectId // user ids of assignees

  project Project @relation(fields: [projectId], references: [id])

  submissions Submission[]
  feedback    Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============ SUBMISSION ============
model Submission {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  fileName   String
  fileUrl    String
  version    Int       @default(1)
  notes      String?
  status     String    @default("pending") // pending | approved | revision
  reviewedAt DateTime?

  milestoneId   String @db.ObjectId
  submittedById String @db.ObjectId

  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  submittedBy User      @relation("SubmittedBy", fields: [submittedById], references: [id])

  feedback Feedback[]

  createdAt DateTime @default(now())

  @@index([milestoneId])
  @@index([submittedById])
}

// ============ FEEDBACK ============
model Feedback {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  content        String
  inlineComments String[]
  resolved       Boolean  @default(false)
  readByIds      String[] @db.ObjectId

  projectId    String  @db.ObjectId
  milestoneId  String? @db.ObjectId
  submissionId String? @db.ObjectId
  authorId     String  @db.ObjectId

  project    Project     @relation(fields: [projectId], references: [id])
  milestone  Milestone?  @relation(fields: [milestoneId], references: [id])
  submission Submission? @relation(fields: [submissionId], references: [id])
  author     User        @relation("FeedbackAuthor", fields: [authorId], references: [id])

  replies FeedbackReply[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([submissionId])
  @@index([authorId])
}

// ============ FEEDBACK REPLY ============
model FeedbackReply {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  feedbackId String   @db.ObjectId
  authorId   String   @db.ObjectId

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  author   User     @relation("ReplyAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([feedbackId])
  @@index([authorId])
}

// ============ TEAM CHAT MESSAGE ============
model Message {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  content  String
  teamId   String @db.ObjectId
  authorId String @db.ObjectId

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User @relation("MessageAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// ============ TASK ============
model Task {
  id     String    @id @default(auto()) @map("_id") @db.ObjectId
  title  String
  due    DateTime?
  status String    @default("pending") // pending | done | revision

  teamId       String  @db.ObjectId
  projectId    String? @db.ObjectId
  assignedToId String? @db.ObjectId

  team       Team     @relation(fields: [teamId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  assignedTo User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([projectId])
  @@index([assignedToId])
}

// ============ INVITE ============
model Invite {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  who    String // display text, kept so /my-team still works
  name   String?
  email  String?
  role   String @default("MEMBER") // MEMBER | SUPERVISOR
  status String @default("pending") // pending | accepted | declined | cancelled

  tokenHash String? // sha256 of the emailed token
  expiresAt DateTime?

  teamId      String  @db.ObjectId
  inviteeId   String? @db.ObjectId
  invitedById String? @db.ObjectId

  team      Team  @relation(fields: [teamId], references: [id])
  invitee   User? @relation("InviteeUser", fields: [inviteeId], references: [id])
  invitedBy User? @relation("InviteSender", fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([inviteeId])
  @@index([status])
  @@index([tokenHash])
}